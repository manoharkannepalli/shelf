{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Shelf desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://*/*" }
      ]
    },
    "opener:default"
  ]
}
