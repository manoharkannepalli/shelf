{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Shelf desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPLOCALDATA/**" }],
      "deny": [{ "path": "$APPLOCALDATA/EBWebView/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*/*" }]
    },
    "opener:allow-default-urls"
  ]
}
